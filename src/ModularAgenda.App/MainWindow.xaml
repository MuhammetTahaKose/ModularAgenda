<Window Language="tr-TR" x:Class="ModularAgenda.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ModularAgenda.App"
        mc:Ignorable="d"
        Title="Aylık Takvim" Height="650" Width="1050" MinHeight="500" MinWidth="800">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="DayButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D9E1F2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="Command" Value="{Binding DataContext.SelectDayCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="CommandParameter" Value="{Binding}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsInDisplayedMonth}" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsToday}" Value="True">
                    <Setter Property="BorderBrush" Value="#2F75B5" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="#DDEBF7" />
                    <Setter Property="BorderBrush" Value="#1F4E79" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="1.25*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Column="0" Margin="0,0,20,16">
            <Button DockPanel.Dock="Left" Content="‹" FontSize="26" Width="42" Height="38" Command="{Binding PreviousMonthCommand}" />
            <Button DockPanel.Dock="Right" Content="›" FontSize="26" Width="42" Height="38" Command="{Binding NextMonthCommand}" />
            <TextBlock Text="{Binding MonthTitle}" FontSize="25" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </DockPanel>
        <TextBlock Grid.Column="1" Text="Gün notu" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16" />

        <UniformGrid Grid.Row="1" Grid.Column="0" Columns="7" Margin="0,0,20,4">
            <TextBlock Text="Pzt" HorizontalAlignment="Center" FontWeight="SemiBold" />
            <TextBlock Text="Sal" HorizontalAlignment="Center" FontWeight="SemiBold" />
            <TextBlock Text="Çar" HorizontalAlignment="Center" FontWeight="SemiBold" />
            <TextBlock Text="Per" HorizontalAlignment="Center" FontWeight="SemiBold" />
            <TextBlock Text="Cum" HorizontalAlignment="Center" FontWeight="SemiBold" />
            <TextBlock Text="Cmt" HorizontalAlignment="Center" FontWeight="SemiBold" />
            <TextBlock Text="Paz" HorizontalAlignment="Center" FontWeight="SemiBold" />
        </UniformGrid>

        <ItemsControl Grid.Row="2" Grid.Column="0" ItemsSource="{Binding Days}" Margin="0,0,20,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="7" Rows="6" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource DayButtonStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{Binding DayNumber}" FontSize="16" />
                            <Ellipse Grid.Row="1" Width="7" Height="7" Fill="#2F75B5" HorizontalAlignment="Left" VerticalAlignment="Bottom" Visibility="{Binding HasNote, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" BorderBrush="#D9E1F2" BorderThickness="1" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding SelectedDate, StringFormat={}{0:dd MMMM yyyy}}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,12" />
                <TextBox Grid.Row="1" Text="{Binding NoteText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                <Button Grid.Row="2" Content="Kaydet" Height="36" Margin="0,12,0,8" Command="{Binding SaveNoteCommand}" />
                <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="#9C0006" />
            </Grid>
        </Border>
    </Grid>
</Window>
